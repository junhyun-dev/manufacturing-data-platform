# Safe loopback configuration for the bounded sample preview.
# Copy this file to .env and replace release/revision when building a named artifact.
MFG_REVIEW_MODE=sample
MFG_REVIEW_BIND=127.0.0.1
MFG_REVIEW_PORT=8000
MFG_REVIEW_HOSTS=localhost,127.0.0.1,[::1]
MFG_REVIEW_SECURE_COOKIE=0
MFG_REVIEW_RELEASE=0.1.0-dev
MFG_REVIEW_REVISION=local
